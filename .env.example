# ==============================================================================
# FS25-LXC — Exemple de configuration. Copiez ce fichier en ".env" (gitignoré,
# JAMAIS commité) et renseignez vos valeurs. Aucun secret dans le git !
# ==============================================================================

# --- Conteneur LXC (presets façon ct/ubuntu.sh, tous modifiables) --------------
# VMID vide = prochain ID libre (pvesh get /nextid)
#VMID=120
CT_HOSTNAME=fs25
VAR_OS=ubuntu
VAR_VERSION=26.04            # Ubuntu 26.04 LTS (Resolute Raccoon) / 26.04.1
VAR_UNPRIVILEGED=1
CT_STORAGE=local-lvm
# Presets ressources (recommandations GIANTS) — modifiables :
CT_CPU=4                     # vCPU : 3 (2-10 joueurs) à 4 (16 joueurs)
CT_RAM=8192                  # Mo : 4096 (2-4 joueurs) / 8192 (5-10) / 12288 (16, tous DLC)
CT_DISK=64                   # Go : >50 jeu de base, >65 avec tous les DLC
CT_SWAP=512
# DHCP : name=eth0,bridge=vmbr0,ip=dhcp
# Statique : name=eth0,bridge=vmbr0,ip=192.168.1.120/24,gw=192.168.1.1
CT_NET="name=eth0,bridge=vmbr0,ip=dhcp"
# CT_ROOT_PASSWORD=...      # demandé en interactif si vide (ou généré si non interactif)

# --- SteamCMD / source du jeu ---------------------------------------------------
FS_SOURCE=steamcmd           # steamcmd (Steam, appid 2300320) | eshop (installeur GIANTS eShop)
STEAM_LOGIN_MODE=account     # account (recommandé, licence requise) | anonymous (échouera sans licence)
STEAM_USER=                  # compte Steam possédant Farming Simulator 25 (2e licence)
STEAM_PASS=                  # mot de passe — JAMAIS commité, .env est gitignoré
STEAM_GUARD=                 # code Steam Guard si demandé (vide sinon)
FS_APPID=2300320
FS_INSTALL_DIR=/opt/fs25

# --- Serveur FS25 (dedicatedServer.xml + dedicatedServerConfig.xml) -------------
FS_WEB_PORT=8080             # panneau web HTTP
FS_WEB_TLS_PORT=8443         # panneau web HTTPS
FS_WEB_ADMIN_USER=admin      # initial_admin du panneau web
FS_WEB_ADMIN_PASS=           # mot de passe initial du panneau web (laissez le panneau le changer ensuite)
FS_GAME_NAME="FS25 Server"   # nom affiché dans le navigateur de serveurs (30 caractères max)
FS_GAME_PASSWORD=            # mot de passe pour rejoindre la partie (vide = serveur public)
FS_ADMIN_PASSWORD=           # mot de passe admin en jeu
FS_MAX_PLAYERS=16
FS_PORT=10823                # port jeu TCP+UDP
FS_LANGUAGE=fr
FS_SAVE_INTERVAL=180         # auto-save en secondes (180 = 3 min)
FS_CROSSPLAY=true
FS_ECONOMIC_DIFFICULTY=2     # 1 facile, 2 normal, 3 difficile
FS_PAUSE_IF_EMPTY=2          # 1 = ne jamais pause, 2 = pause si aucun joueur
FS_INITIAL_MONEY=500000
FS_SAVEGAME_INDEX=1          # 1-20
FS_MAP=MapUS                 # MapUS (Elmcreek), MapFR (Haut-Beyleron), MapAlpine (Erlengrat)
